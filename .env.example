# Application
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
VOICE_RUNTIME_URL=http://localhost:4100
API_PORT=4000
VOICE_RUNTIME_PORT=4100

# Database & cache
DATABASE_URL=postgresql://sonrat:sonrat@localhost:5432/sonrat
REDIS_URL=redis://localhost:6379

# Auth (min 32 chars)
AUTH_SECRET=dev-secret-change-me-to-a-long-random-string
AUTH_COOKIE_NAME=sonrat_session
AUTH_SESSION_TTL_SECONDS=604800

# Providers (use mock in local/dev)
AI_PROVIDER=mock
TELEPHONY_PROVIDER=mock
STORAGE_PROVIDER=local
MOCK_AI=true
MOCK_TELEPHONY=true
DEMO_MODE=true

# Gemini Live (required when AI_PROVIDER=gemini and MOCK_AI=false)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Exotel (required when TELEPHONY_PROVIDER=exotel and MOCK_TELEPHONY=false)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_PHONE_NUMBER=
EXOTEL_WEBHOOK_BASE_URL=http://localhost:4000
EXOTEL_MAX_CALL_DURATION_SECONDS=600

# Object storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_ENDPOINT=
LOCAL_STORAGE_PATH=./uploads

# Ops
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=100000
DEFAULT_ORG_MAX_CONCURRENT_CALLS=10
