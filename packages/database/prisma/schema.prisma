generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  AGENT_MANAGER
  ANALYST
  MEMBER
}

enum AgentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AgentVersionStatus {
  ACTIVE
  SUPERSEDED
  DRAFT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum CallStatus {
  QUEUED
  INITIATING
  RINGING
  CONNECTED
  AI_ACTIVE
  HUMAN_HANDOFF
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED
  RETRY_SCHEDULED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  CALLBACK_REQUESTED
  APPOINTMENT_BOOKED
  CONVERTED
  WRONG_NUMBER
  NO_ANSWER
  BUSY
  FAILED
  HUMAN_HANDOFF
  DO_NOT_CALL
}

enum ContactCallability {
  callable
  do_not_call
  blocked
  invalid
  consent_required
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  PREVIEW_READY
  COMMITTING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  DEAD_LETTER
  CANCELLED
}

model Organization {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String   @unique
  timezone              String   @default("UTC")
  maxConcurrentCalls    Int      @default(10)
  featureFlags          Json     @default("{}")
  retentionDays         Int      @default(365)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  members               OrganizationMember[]
  agents                Agent[]
  contacts              Contact[]
  contactImports        ContactImport[]
  campaigns             Campaign[]
  phoneNumbers          PhoneNumber[]
  calls                 Call[]
  leads                 Lead[]
  appointments          Appointment[]
  auditLogs             AuditLog[]
  usageRecords          UsageRecord[]
  notifications         Notification[]
  webhookEvents         WebhookEvent[]
  idempotencyKeys       IdempotencyKey[]
  outboxEvents          OutboxEvent[]
  toolExecutions        ToolExecution[]
  agentFlows            AgentFlow[]

  @@index([createdAt])
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String
  name              String
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  memberships       OrganizationMember[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  workspaceState    UserWorkspaceState?

  @@index([email])
}

model UserWorkspaceState {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  pinnedServices  Json     @default("[]")
  recentServices  Json     @default("[]")
  bookmarks       Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  tokenHash     String   @unique
  organizationId String? @db.Uuid
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Agent {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @db.Uuid
  name             String
  description      String?
  status           AgentStatus @default(DRAFT)
  draftConfig      Json        @default("{}")
  activeVersionId  String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions         AgentVersion[]
  campaigns        Campaign[]
  calls            Call[]
  phoneNumbers     PhoneNumber[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model AgentVersion {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  agentId        String             @db.Uuid
  versionNumber  Int
  status         AgentVersionStatus @default(DRAFT)
  config         Json
  systemPrompt   String
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  agent          Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  calls          Call[]

  @@unique([agentId, versionNumber])
  @@index([organizationId, agentId])
}

model AgentFlow {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @db.Uuid
  name             String
  description      String?
  status           AgentStatus @default(DRAFT)
  draftGraph       Json        @default("{\"nodes\":[],\"edges\":[]}")
  activeVersionId  String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions         AgentFlowVersion[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model AgentFlowVersion {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  flowId         String             @db.Uuid
  versionNumber  Int
  status         AgentVersionStatus @default(DRAFT)
  graph          Json
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  flow           AgentFlow          @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, versionNumber])
  @@index([organizationId, flowId])
}

model Contact {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  name             String
  rawPhone         String
  normalizedPhone  String?
  countryCode      String?
  email            String?
  company          String?
  tags             String[]           @default([])
  customFields     Json               @default("{}")
  leadStatus       String?
  notes            String?
  source           String?
  timezone         String?
  callability      ContactCallability @default(callable)
  lastCalledAt     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignContacts CampaignContact[]
  calls            Call[]
  leads            Lead[]
  appointments     Appointment[]

  @@index([organizationId, normalizedPhone])
  @@index([organizationId, createdAt])
  @@index([organizationId, callability])
  @@unique([organizationId, normalizedPhone])
}

model ContactImport {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  fileName       String
  objectKey      String
  contentType    String
  status         ImportStatus @default(UPLOADED)
  totalRows      Int          @default(0)
  validRows      Int          @default(0)
  invalidRows    Int          @default(0)
  columnMapping  Json         @default("{}")
  errorReportKey String?
  summary        Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rows           ContactImportRow[]

  @@index([organizationId, status])
}

model ContactImportRow {
  id             String   @id @default(uuid()) @db.Uuid
  importId       String   @db.Uuid
  rowNumber      Int
  rawData        Json
  normalizedData Json?
  errors         String[] @default([])
  isValid        Boolean  @default(false)
  committed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  import         ContactImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, isValid])
  @@unique([importId, rowNumber])
}

model Campaign {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @db.Uuid
  name                  String
  description           String?
  agentId               String         @db.Uuid
  agentVersionId        String?        @db.Uuid
  phoneNumberId         String?        @db.Uuid
  status                CampaignStatus @default(DRAFT)
  objective             String
  salesInstructions     String?
  campaignInstructions  String?
  callingHoursStart     String         @default("09:00")
  callingHoursEnd       String         @default("18:00")
  timezone              String         @default("UTC")
  maxAttempts           Int            @default(3)
  retryDelayMinutes     Int            @default(60)
  concurrencyLimit      Int            @default(5)
  callTimeoutSeconds    Int            @default(120)
  callbackBehavior      String?
  priority              Int            @default(5)
  startAt               DateTime?
  endAt                 DateTime?
  metrics               Json           @default("{}")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent                 Agent             @relation(fields: [agentId], references: [id])
  agentVersion          AgentVersion?     @relation(fields: [agentVersionId], references: [id])
  phoneNumber           PhoneNumber?      @relation(fields: [phoneNumberId], references: [id])
  contacts              CampaignContact[]
  calls                 Call[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model CampaignContact {
  id             String     @id @default(uuid()) @db.Uuid
  campaignId     String     @db.Uuid
  contactId      String     @db.Uuid
  status         CallStatus @default(QUEUED)
  attemptCount   Int        @default(0)
  nextAttemptAt  DateTime?
  lastCallId     String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  campaign       Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact        Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([nextAttemptAt])
}

model PhoneNumber {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  provider       String   @default("exotel")
  e164           String
  displayName    String?
  inboundAgentId String?  @db.Uuid
  isActive       Boolean  @default(true)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inboundAgent   Agent?       @relation(fields: [inboundAgentId], references: [id])
  campaigns      Campaign[]
  calls          Call[]

  @@unique([organizationId, e164])
  @@index([e164])
}

model Call {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @db.Uuid
  campaignId          String?        @db.Uuid
  contactId           String?        @db.Uuid
  agentId             String         @db.Uuid
  agentVersionId      String         @db.Uuid
  phoneNumberId       String?        @db.Uuid
  provider            String
  providerCallId      String?
  direction           CallDirection
  status              CallStatus     @default(QUEUED)
  startedAt           DateTime?
  connectedAt         DateTime?
  endedAt             DateTime?
  durationSeconds     Int?
  language            String?
  outcome             CallOutcome?
  failureReason       String?
  recordingReference  String?
  transcriptReference String?
  metadata            Json           @default("{}")
  idempotencyKey      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign            Campaign?      @relation(fields: [campaignId], references: [id])
  contact             Contact?       @relation(fields: [contactId], references: [id])
  agent               Agent          @relation(fields: [agentId], references: [id])
  agentVersion        AgentVersion   @relation(fields: [agentVersionId], references: [id])
  phoneNumber         PhoneNumber?   @relation(fields: [phoneNumberId], references: [id])
  events              CallEvent[]
  sessions            CallSession[]
  conversation        Conversation?
  outcomeRecord       CallOutcomeRecord?
  leads               Lead[]
  appointments        Appointment[]
  toolExecutions      ToolExecution[]
  usageRecords        UsageRecord[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([campaignId])
  @@index([providerCallId])
  @@index([agentId])
}

model CallEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  callId         String   @db.Uuid
  type           String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())

  call           Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
  @@index([organizationId, type])
}

model CallSession {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  callId              String    @db.Uuid
  providerSessionId   String?
  geminiSessionId     String?
  resumptionToken     String?
  conversationLanguage String?
  detectedLanguage    String?
  languageHistory     Json      @default("[]")
  status              String    @default("active")
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  metadata            Json      @default("{}")

  call                Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([organizationId, status])
}

model Conversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  callId         String   @unique @db.Uuid
  language       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  call           Call                   @relation(fields: [callId], references: [id], onDelete: Cascade)
  messages       ConversationMessage[]
  transcripts    CallTranscript[]

  @@index([organizationId])
}

model ConversationMessage {
  id               String   @id @default(uuid()) @db.Uuid
  conversationId   String   @db.Uuid
  role             String
  content          String
  language         String?
  toolCallId       String?
  providerMetadata Json     @default("{}")
  createdAt        DateTime @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CallTranscript {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  fullText       String
  segments       Json     @default("[]")
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model CallRecording {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  callId         String   @db.Uuid
  objectKey      String
  durationSeconds Int?
  contentType    String
  retentionUntil DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId, callId])
}

model CallOutcomeRecord {
  id                   String      @id @default(uuid()) @db.Uuid
  organizationId       String      @db.Uuid
  callId               String      @unique @db.Uuid
  outcome              CallOutcome
  summary              String?
  intent               String?
  sentiment            String?
  leadStatus           String?
  interestLevel        String?
  nextAction           String?
  callbackRequired     Boolean     @default(false)
  appointmentRequired  Boolean     @default(false)
  humanHandoff         Boolean     @default(false)
  productsDiscussed    String[]    @default([])
  objections           String[]    @default([])
  customerQuestions    String[]    @default([])
  language             String?
  metadata             Json        @default("{}")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  call                 Call        @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([organizationId, outcome])
}

model Lead {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  contactId      String?  @db.Uuid
  callId         String?  @db.Uuid
  status         String   @default("new")
  interestLevel  String?
  notes          String?
  metadata       Json     @default("{}")
  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id])
  call           Call?        @relation(fields: [callId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
}

model Appointment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  contactId      String?  @db.Uuid
  callId         String?  @db.Uuid
  scheduledAt    DateTime
  timezone       String   @default("UTC")
  status         String   @default("scheduled")
  notes          String?
  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id])
  call           Call?        @relation(fields: [callId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, scheduledAt])
}

model ToolExecution {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  callId         String?   @db.Uuid
  toolName       String
  input          Json
  output         Json?
  status         String    @default("pending")
  error          String?
  idempotencyKey String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  durationMs     Int?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  call           Call?        @relation(fields: [callId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([callId, toolName])
}

model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  callId         String?  @db.Uuid
  campaignId     String?  @db.Uuid
  agentId        String?  @db.Uuid
  metric         String
  quantity       Decimal  @db.Decimal(18, 6)
  unit           String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  call           Call?        @relation(fields: [callId], references: [id])

  @@index([organizationId, metric, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  resource       String
  resourceId     String?
  metadata       Json     @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
}

model WebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  provider       String
  eventKey       String
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, eventKey])
  @@index([createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, type])
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  type           String
  title          String
  body           String
  readAt         DateTime?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, readAt])
}

model DeadLetterJob {
  id             String   @id @default(uuid()) @db.Uuid
  queue          String
  jobId          String
  payload        Json
  error          String
  attempts       Int
  createdAt      DateTime @default(now())

  @@index([queue, createdAt])
}
