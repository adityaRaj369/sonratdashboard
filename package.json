{
  "name": "sonrat",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-tenant AI voice sales and customer support platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@sonrat/web",
    "dev:api": "turbo run dev --filter=@sonrat/api",
    "dev:worker": "turbo run dev --filter=@sonrat/worker",
    "dev:voice": "turbo run dev --filter=@sonrat/voice-runtime",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@sonrat/shared --filter=@sonrat/api --filter=@sonrat/voice-runtime",
    "db:generate": "pnpm --filter @sonrat/database generate",
    "db:migrate": "pnpm --filter @sonrat/database migrate",
    "db:migrate:deploy": "pnpm --filter @sonrat/database migrate:deploy",
    "db:seed": "pnpm --filter @sonrat/database seed",
    "db:studio": "pnpm --filter @sonrat/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
